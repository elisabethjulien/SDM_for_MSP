rescale <- function(raster_layer) {
  # Get min/max
  minmax_r <- range(values(raster_layer), na.rm = TRUE)
  
  # Rescale between 0 and 1
  rescaled_values <- (raster_layer - minmax_r[1]) / diff(minmax_r)
  
  return(rescaled_values)
}

